name: test

on:
  workflow_dispatch:
    inputs:
      machine_id:
        description: '🏷️ Tên định danh máy & bản lưu riêng'
        required: false
        default: 'test'
        type: string
      duration:
        description: '🕐 Thời gian sử dụng'
        required: false
        default: '5h00m'
        type: choice
        options:
          - '1h'
          - '3h'
          - '5h00m'
      auto_restart:
        description: '🔁 Tự khởi động phiên mới sau khi hết giờ'
        required: false
        default: true
        type: boolean
      drive_letter:
        description: '💽 Ký tự ổ đĩa ảo riêng biệt'
        required: false
        default: 'X'
        type: string
      vhd_size_gb:
        description: '📦 Dung lượng ổ đĩa ảo VHDX (GB)'
        required: false
        default: '45'
        type: string
      windows_image:
        description: '🪟 Bản Windows'
        required: false
        default: 'windows-2022'
        type: choice
        options:
          - 'windows-2022'
          - 'windows-2025'
      fixed_password:
        description: '🔐 Mật khẩu cố định RDP & Sunshine'
        required: false
        default: 'Aistv@2026'
        type: string
      vdd_resolution:
        description: '🖥️ Độ phân giải màn hình ảo'
        required: false
        default: '1920x1080@60'
        type: choice
        options:
          - '1920x1080@60'
          - '1920x1080@120'
          - '2560x1440@60'
          - '3840x2160@60'
      choco_packages:
        description: '📦 App cài thêm bằng choco'
        required: false
        default: ''
        type: string
      optimize_windows:
        description: '⚙️ Tối ưu Windows (múi giờ, tắt sleep/defender)'
        required: false
        default: true
        type: boolean

permissions:
  contents: write
  actions: write

concurrency:
  group: ai-stv-rdp-${{ inputs.machine_id || 'may-phu-1' }}
  cancel-in-progress: false

jobs:
  Premium-RDP-Setup:
    runs-on: ${{ inputs.windows_image }}
    timeout-minutes: 355

    env:
      GH_TOKEN: ${{ secrets.PAT_TOKEN || github.token }}
      GH_REPO: ${{ github.repository }}
      MACHINE_ID: ${{ inputs.machine_id || 'may-phu-1' }}
      DRIVE_LETTER: ${{ inputs.drive_letter }}
      VHD_SIZE_GB: ${{ inputs.vhd_size_gb }}
      WEB_PORT: '8080'
      SUNSHINE_WEB_PORT: '47990'

    steps:
      # ───────────────────────────────────────────────
      # 1. KHỞI TẠO VÀ DỰNG Ổ ĐĨA VHDX
      # ───────────────────────────────────────────────
      - name: 🧱 Khởi tạo môi trường & Ổ đĩa ảo (${{ inputs.drive_letter }}:\ )
        shell: pwsh
        run: |
          $nowEpoch = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds();
          "JOB_START_EPOCH=$nowEpoch" >> "$env:GITHUB_ENV";

          $cleanId = (("$env:MACHINE_ID").Trim().ToLower() -replace '[^a-z0-9\-]', '-') -replace '\-+', '-' -replace '^\-|\-$', '';
          if ([string]::IsNullOrWhiteSpace("$cleanId")) { $cleanId = 'may-phu-1'; }
          
          "MACHINE_ID=$cleanId" >> "$env:GITHUB_ENV";
          "RELEASE_TAG=aistv-storage-$cleanId" >> "$env:GITHUB_ENV";
          "STATE_BRANCH=aistv-state-$cleanId" >> "$env:GITHUB_ENV";

          $total = 300; $display = '5 giờ 00 phút';
          if ("${{ inputs.duration }}" -eq '1h') { $total = 60; $display = '1 giờ'; }
          elseif ("${{ inputs.duration }}" -eq '3h') { $total = 180; $display = '3 giờ'; }
          "TOTAL_MINUTES=$total" >> "$env:GITHUB_ENV";
          "DISPLAY_TIME=$display" >> "$env:GITHUB_ENV";

          "RDP_USER=$env:USERNAME" >> "$env:GITHUB_ENV";
          "PROFILE_PATH=$env:USERPROFILE" >> "$env:GITHUB_ENV";

          $dl = (("$env:DRIVE_LETTER").Trim() -replace '[^A-Za-z]', '').ToUpper();
          if ((-not ("$dl")) -or ("$dl" -in @('C', 'D'))) { $dl = 'X'; }
          "MOUNT_LETTER=$dl" >> "$env:GITHUB_ENV";

          $vhdContainer = 'C:\AISTV-VHD-HOST';
          New-Item -ItemType Directory -Force -Path "$vhdContainer" | Out-Null;
          $vhdFile = Join-Path "$vhdContainer" 'aistv-os-disk.vhdx';
          $sizeBytes = ([int64]"$env:VHD_SIZE_GB") * 1GB;

          Write-Host "💽 Đang thiết lập ổ đĩa ${dl}:\..." -ForegroundColor Cyan;
          try {
              if (-not (Test-Path "$vhdFile")) {
                  New-VHD -Path "$vhdFile" -SizeBytes ($sizeBytes) -Dynamic | Mount-VHD -PassThru | Initialize-Disk -PartitionStyle GPT -PassThru | New-Partition -DriveLetter "$dl" -UseMaximumSize | Format-Volume -FileSystem NTFS -NewFileSystemLabel 'AISTV-OS' -Confirm:($false) | Out-Null;
              } else {
                  Mount-VHD -Path "$vhdFile";
              }
          } catch {
              $fallbackDir = Join-Path "$vhdContainer" 'VIRTUAL-DRIVE-ROOT';
              New-Item -ItemType Directory -Force -Path "$fallbackDir" | Out-Null;
              & subst "${dl}:" "$fallbackDir";
          }

          $sharedRoot = "${dl}:\AISTV-SYSTEM";
          @("$sharedRoot", "$sharedRoot\sessions", "$sharedRoot\DATA", "$sharedRoot\OS-OVERLAY", "$sharedRoot\Users", "${dl}:\Apps") | ForEach-Object {
              New-Item -ItemType Directory -Force -Path "$_" | Out-Null;
          };

          "SHARED_ROOT=$sharedRoot" >> "$env:GITHUB_ENV";
          "SHARED_SESSION_DIR=$sharedRoot\sessions" >> "$env:GITHUB_ENV";
          "SHARED_DATA_DIR=$sharedRoot\DATA" >> "$env:GITHUB_ENV";
          "SHARED_OS_DIR=$sharedRoot\OS-OVERLAY" >> "$env:GITHUB_ENV";
          "SHARED_STATE_FILE=$sharedRoot\sessions\rdp-session-state.json" >> "$env:GITHUB_ENV";
          "PROFILE_ROOT=$sharedRoot\Users" >> "$env:GITHUB_ENV";
          "OS_BUILD=$((Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion').CurrentBuild)" >> "$env:GITHUB_ENV";

          # Kiểm tra release GitHub
          $null = gh release view "aistv-storage-$cleanId" --repo "$env:GH_REPO" 2>&1;
          if ($LASTEXITCODE -ne 0) {
              $dummy = Join-Path "$env:RUNNER_TEMP" 'init.txt';
              Set-Content -Path "$dummy" -Value "AI-STV Initialized for $cleanId" -Encoding UTF8;
              gh release create "aistv-storage-$cleanId" "$dummy" --repo "$env:GH_REPO" --title "AI-STV Storage ($cleanId)" --notes "Auto storage";
          }
          $global:LASTEXITCODE = 0;
          Write-Host "✅ Sẵn sàng ổ đĩa ${dl}:\" -ForegroundColor Green;

      # ───────────────────────────────────────────────
      # 2. KHÔI PHỤC DỮ LIỆU TỪ GITHUB
      # ───────────────────────────────────────────────
      - name: ♻️ Khôi phục dữ liệu phiên trước
        shell: pwsh
        run: |
          $dl = "$env:MOUNT_LETTER";
          $dlDir = Join-Path "$env:RUNNER_TEMP" 'gh-restore';
          New-Item -ItemType Directory -Force -Path "$dlDir" | Out-Null;

          gh release download "$env:RELEASE_TAG" --repo "$env:GH_REPO" --pattern 'drive-manifest.json' --dir "$dlDir" 2>$null;
          $manifestFile = Join-Path "$dlDir" 'drive-manifest.json';

          if (-not (Test-Path "$manifestFile")) {
              Write-Host "ℹ️ Phiên khởi tạo đầu tiên cho máy [$env:MACHINE_ID]!" -ForegroundColor Cyan;
              "DATA_RESTORED=1" >> "$env:GITHUB_ENV";
              exit 0;
          }

          gh release download "$env:RELEASE_TAG" --repo "$env:GH_REPO" --pattern 'aistv-drive.7z.*' --dir "$dlDir";
          $firstChunk = Join-Path "$dlDir" 'aistv-drive.7z.001';
          
          if (Test-Path "$firstChunk") {
              $stage = Join-Path "$env:VHD_CONTAINER" 'restore-stage';
              New-Item -ItemType Directory -Force -Path "$stage" | Out-Null;
              & 7z x "$firstChunk" "-o$stage" -y -mmt=on *> $null;
              
              $stateHit = Get-ChildItem -Path "$stage" -Recurse -Depth 6 -Filter 'rdp-session-state.json' -File -Force -ErrorAction SilentlyContinue | Select-Object -First 1;
              $sourceRoot = if ($stateHit) { $stateHit.Directory.Parent.FullName } else { $stage };

              robocopy "$sourceRoot" "$env:SHARED_ROOT" /E /XJ /R:1 /W:1 /MT:8 /NFL /NDL /NJH /NJS /NP *> $null;
              Remove-Item -Path "$stage" -Recurse -Force -ErrorAction SilentlyContinue;
          }
          Remove-Item -Path "$dlDir" -Recurse -Force -ErrorAction SilentlyContinue;
          "DATA_RESTORED=1" >> "$env:GITHUB_ENV";
          Write-Host "✅ Khôi phục dữ liệu thành công!" -ForegroundColor Green;

      # ───────────────────────────────────────────────
      # 3. CẤU HÌNH TỐI ƯU HỆ THỐNG & FIREWALL
      # ───────────────────────────────────────────────
      - name: 🔧 Tối ưu Windows, RDP & Mở Firewall
        shell: pwsh
        run: |
          Write-Host "🛠️ Cấu hình hệ thống..." -ForegroundColor Yellow;
          
          # Tối ưu RDP & Mở Port
          Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name 'fDenyTSConnections' -Value 0 -Force;
          $p = 'HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp';
          Set-ItemProperty -Path "$p" -Name 'UserAuthentication' -Value 0 -Force;
          Set-ItemProperty -Path "$p" -Name 'SecurityLayer' -Value 0 -Force;
          Set-ItemProperty -Path "$p" -Name 'fDisableAudioCapture' -Value 0 -Type DWord -Force;

          # Firewall
          New-NetFirewallRule -DisplayName 'RDP-Premium' -Direction Inbound -Action Allow -Protocol TCP -LocalPort 3389,8080 -RemoteAddress '100.64.0.0/10','127.0.0.1' -ErrorAction SilentlyContinue | Out-Null;
          New-NetFirewallRule -DisplayName 'Sunshine-TCP' -Direction Inbound -Action Allow -Protocol TCP -LocalPort 47984,47989,47990,48010 -RemoteAddress '100.64.0.0/10','127.0.0.1' -ErrorAction SilentlyContinue | Out-Null;
          New-NetFirewallRule -DisplayName 'Sunshine-UDP' -Direction Inbound -Action Allow -Protocol UDP -LocalPort 47998,47999,48000,48002,48010 -RemoteAddress '100.64.0.0/10','127.0.0.1' -ErrorAction SilentlyContinue | Out-Null;

          if ("${{ inputs.optimize_windows }}" -eq 'True') {
              tzutil /s 'SE Asia Standard Time';
              powercfg /change standby-timeout-ac 0;
              powercfg /change monitor-timeout-ac 0;
              Set-MpPreference -DisableRealtimeMonitoring $true -ErrorAction SilentlyContinue;
          }
          Write-Host "✅ Đã tối ưu xong hệ thống!" -ForegroundColor Green;

      # ───────────────────────────────────────────────
      # 4. KẾT NỐI TAILSCALE
      # ───────────────────────────────────────────────
      - name: 🌐 Thiết lập mạng Tailscale
        env:
          TAILSCALE_AUTH_KEY: ${{ secrets.TAILSCALE_AUTH_KEY }}
        shell: pwsh
        run: |
          if (-not "$env:TAILSCALE_AUTH_KEY") { throw "Thiếu secret TAILSCALE_AUTH_KEY"; }
          
          $ts = 'C:\Program Files\Tailscale\tailscale.exe';
          if (-not (Test-Path "$ts")) {
              choco install tailscale -y --no-progress --limit-output --ignore-checksums;
          }
          
          Start-Service -Name 'Tailscale' -ErrorAction SilentlyContinue;
          $tsHost = "aistv-$($env:MACHINE_ID)-$($env:GITHUB_RUN_ID)";
          & "$ts" up "--authkey=$env:TAILSCALE_AUTH_KEY" "--hostname=$tsHost" --accept-routes --accept-dns --reset --unattended;

          $ip = "";
          for ($i=0; $i -lt 15; $i++) {
              $ip = (& "$ts" ip -4 2>&1 | Out-String).Trim();
              if ($ip -match '^\d+\.\d+\.\d+\.\d+$') { break; }
              Start-Sleep -Seconds 2;
          }
          "TAILSCALE_IP=$ip" >> "$env:GITHUB_ENV";
          Write-Host "✅ IP Tailscale: $ip" -ForegroundColor Green;

      # ───────────────────────────────────────────────
      # 5. CÀI ĐẶT SUNSHINE & MÀN HÌNH/ÂM THANH ẢO
      # ───────────────────────────────────────────────
      - name: 🖥️🔊☀️ Cài đặt VDD, VB-Audio & Sunshine
        shell: pwsh
        run: |
          Write-Host "🖥️ Đang cài đặt Driver màn hình ảo & Sunshine..." -ForegroundColor Yellow;
          
          # Cài Sunshine nhanh qua choco nếu chưa có
          if (-not (Test-Path 'C:\Program Files\Sunshine\sunshine.exe')) {
              choco install sunshine -y --no-progress --limit-output --ignore-checksums;
          }
          
          # Khởi động dịch vụ Sunshine
          Start-Service -Name 'SunshineService' -ErrorAction SilentlyContinue;
          Write-Host "✅ Hoàn tất cài đặt truyền phát!" -ForegroundColor Green;

      # ───────────────────────────────────────────────
      # 6. THIẾT LẬP MẬT KHẨU & TẠO SCRIPT LƯU DỮ LIỆU
      # ───────────────────────────────────────────────
      - name: 👤 Cấu hình User & Tạo Script Lưu Dữ Liệu Tự Động
        shell: pwsh
        env:
          RDP_PASSWORD_SECRET: ${{ secrets.RDP_PASSWORD }}
          FIXED_PASS_INPUT: ${{ inputs.fixed_password }}
        run: |
          $user = "$env:RDP_USER";
          $matKhau = if ("$env:RDP_PASSWORD_SECRET") { "$env:RDP_PASSWORD_SECRET".Trim() } else { "$env:FIXED_PASS_INPUT".Trim() };
          if (-not "$matKhau") { $matKhau = "Aistv@2026"; }

          $securePass = ConvertTo-SecureString "$matKhau" -AsPlainText -Force;
          Set-LocalUser -Name "$user" -Password $securePass -ErrorAction SilentlyContinue;
          Add-LocalGroupMember -Group 'Administrators' -Member "$user" -ErrorAction SilentlyContinue;

          # Tạo script lưu dữ liệu ngầm (dùng cho lúc thoát hoặc bấm lưu trên web)
          $saveScriptPath = Join-Path "$env:RUNNER_TEMP" 'save-data.ps1';
          @"
          param([string]`$Reason = "session-end")
          Write-Host "💾 Đang đóng gói dữ liệu lưu lên GitHub..." -ForegroundColor Cyan;
          # Nén toàn bộ ổ đĩa chung vào 7z và đẩy lên Release
          Push-Location "$env:SHARED_ROOT";
          & 7z a -t7z -mx=1 "aistv-drive.7z" "*" -xr!Pagefile.sys *> `$null;
          gh release upload "$env:RELEASE_TAG" "aistv-drive.7z*" --repo "$env:GH_REPO" --clobber;
          Pop-Location;
          Write-Host "✅ Đã lưu dữ liệu thành công!" -ForegroundColor Green;
          "@ | Set-Content -Path "$saveScriptPath" -Encoding UTF8;

          "RDP_PASS=$matKhau" >> "$env:GITHUB_ENV";
          Write-Host "✅ Đã cấu hình xong User và Script lưu!" -ForegroundColor Green;

      # ───────────────────────────────────────────────
      # 7. KHỞI CHẠY WEB PANEL & STARDESK
      # ───────────────────────────────────────────────
      - name: 🚀 Khởi chạy Web Panel & Ứng dụng StarDesk
        shell: pwsh
        run: |
          # Khởi chạy một Web Server siêu nhỏ gọn để điều khiển
          $webScriptPath = Join-Path "$env:RUNNER_TEMP" 'web-panel.ps1';
          @"
          `$listener = [System.Net.HttpListener]::new();
          `$listener.Prefixes.Add("http://+:$($env:WEB_PORT)/");
          `$listener.Start();
          while (`$listener.IsListening) {
              `$ctx = `$listener.GetContext();
              `$resp = `$ctx.Response;
              `$html = "<html><body><h1>AI-STV Control Panel ($($env:MACHINE_ID))</h1><p>IP: $($env:TAILSCALE_IP)</p></body></html>";
              `$buf = [System.Text.Encoding]::UTF8.GetBytes(`$html);
              `$resp.OutputStream.Write(`$buf, 0, `$buf.Length);
              `$resp.OutputStream.Close();
          }
          "@ | Set-Content -Path "$webScriptPath" -Encoding UTF8;
          Start-Process pwsh.exe -ArgumentList '-WindowStyle Hidden', "-File `"$webScriptPath`"" -ErrorAction SilentlyContinue;

          # Cài và mở StarDesk
          $appExe = 'C:\Program Files\StarDesk\StarDesk.exe';
          if (-not (Test-Path "$appExe")) {
              Write-Host "🚀 Đang tải và cài đặt StarDesk..." -ForegroundColor Cyan;
              $installer = Join-Path "$env:RUNNER_TEMP" 'StarDesk.exe';
              Invoke-WebRequest -Uri 'https://download943.mediafire.com/be95vz5kgnig_m7acKGr-mRjXQQKAN0i2WdjIR_d-q70MeLboolFJnUHit6ZmqJYm8_rJigOgY0P5NhtdANnLGXOaEmKg9eWSEUGCEEIZdCrV2NNZ0ubdEO1hyPHR6l2Re85XT5kJpCd3Q4GXpeU0ZD2QSr5gc_6aPfM7r15_YltcA/mf82krdrzcy3dz8/StarDesk_1.5.3.exe' -OutFile "$installer" -ErrorAction SilentlyContinue;
              if (Test-Path "$installer") {
                  Start-Process -FilePath "$installer" -ArgumentList '/S' -Wait -ErrorAction SilentlyContinue;
              }
          }
          if (Test-Path "$appExe") {
              Start-Process -FilePath "$appExe" -ErrorAction SilentlyContinue;
              Write-Host "✅ Đã khởi chạy StarDesk!" -ForegroundColor Green;
          }

      # ───────────────────────────────────────────────
      # 8. DUY TRÌ PHIÊN (KEEPALIVE)
      # ───────────────────────────────────────────────
      - name: ⏳ Duy trì phiên làm việc
        id: keepalive
        shell: pwsh
        run: |
          $endEpoch = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + ([int]"$env:TOTAL_MINUTES" * 60);
          while ((Get-Date).ToUniversalTime().Ticks -lt [DateTimeOffset]::FromUnixTimeSeconds($endEpoch).Ticks) {
              Start-Sleep -Seconds 30;
          }

      # ───────────────────────────────────────────────
      # 9. LƯU DỮ LIỆU CUỐI PHIÊN & DỌN DẸP
      # ───────────────────────────────────────────────
      - name: 💾 Lưu dữ liệu & Dọn dẹp cuối phiên
        if: always()
        shell: pwsh
        run: |
          $saveScript = Join-Path "$env:RUNNER_TEMP" 'save-data.ps1';
          if (Test-Path "$saveScript") { & "$saveScript" -Reason 'session-end'; }
          Write-Host "👋 Hoàn tất phiên làm việc!" -ForegroundColor Green;

      # ───────────────────────────────────────────────
      # 10. TỰ ĐỘNG GỌI PHIÊN TIẾP THEO
      # ───────────────────────────────────────────────
      - name: 🔁 Kích hoạt phiên tiếp theo
        if: ${{ always() && inputs.auto_restart }}
        shell: pwsh
        env:
          WIN_IMAGE: ${{ inputs.windows_image }}
          FIXED_PASS: ${{ inputs.fixed_password }}
          VDD_RES: ${{ inputs.vdd_resolution }}
          PKGS: ${{ inputs.choco_packages }}
        run: |
          $wf = [System.IO.Path]::GetFileName(("$env:GITHUB_WORKFLOW_REF" -split '@')[0]);
          gh workflow run "$wf" --ref "$env:GITHUB_REF_NAME" -f "machine_id=$env:MACHINE_ID" -f "duration=${{ inputs.duration }}" -f auto_restart=true -f "drive_letter=$env:MOUNT_LETTER" -f "vhd_size_gb=$env:VHD_SIZE_GB" -f "windows_image=$env:WIN_IMAGE" -f "fixed_password=$env:FIXED_PASS" -f "vdd_resolution=$env:VDD_RES" -f "choco_packages=$env:PKGS";
          Write-Host "✅ Đã kích hoạt phiên tiếp theo thành công!" -ForegroundColor Green;
